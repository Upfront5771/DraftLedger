<Window x:Class="DraftLedger.App.MemoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Memory &amp; continuity | DraftLedger" Icon="Assets/DraftLedger.ico" Width="1040" Height="820" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Memory &amp; continuity" FontFamily="Georgia" FontSize="28" />
      <TextBlock x:Name="IntroText" Margin="0,7,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
      <WrapPanel>
        <Button x:Name="AnalyzeChapterButton" Content="Analyze current chapter" Click="AnalyzeChapter_Click" Style="{StaticResource PrimaryButton}" />
        <Button x:Name="AnalyzeStoryButton" Content="Analyze complete story" Click="AnalyzeStory_Click" />
        <Button Content="Preview memory context" Click="PreviewContext_Click" />
        <Button Content="Open memory files" Click="OpenFiles_Click" />
      </WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" /><Button Content="Close" IsCancel="True" /></StackPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel></Border>
    <TabControl Margin="0,16,0,0">
      <TabItem Header="Overview">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="Story so far" FontWeight="SemiBold" Margin="0,0,0,7" />
          <TextBox x:Name="StorySoFarBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" />
          <TextBlock Grid.Row="2" Text="Style and voice guide" FontWeight="SemiBold" Margin="0,14,0,7" />
          <TextBox x:Name="StyleGuideBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" />
        </Grid>
      </TabItem>
      <TabItem Header="Story bible">
        <DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top"><Button Content="Add fact" Click="AddFact_Click" /><Button Content="Edit selected" Click="EditFact_Click" /><Button Content="Delete selected" Click="DeleteFact_Click" /><Button Content="Lock / unlock" Click="LockFact_Click" /></WrapPanel><ListBox x:Name="FactsList" DisplayMemberPath="Label" Margin="0,12,0,0" /></DockPanel>
      </TabItem>
      <TabItem Header="Plot threads">
        <DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top"><Button Content="Add thread" Click="AddThread_Click" /><Button Content="Edit selected" Click="EditThread_Click" /><Button Content="Open / resolve" Click="ToggleThread_Click" /><Button Content="Delete selected" Click="DeleteThread_Click" /></WrapPanel><ListBox x:Name="ThreadsList" DisplayMemberPath="Label" Margin="0,12,0,0" /></DockPanel>
      </TabItem>
      <TabItem Header="Chapter summaries">
        <DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top"><Button Content="Edit selected" Click="EditChapterSummary_Click" /><Button Content="Refresh stale chapter" Click="RefreshChapter_Click" /></WrapPanel><ListBox x:Name="ChaptersList" DisplayMemberPath="Label" Margin="0,12,0,0" /></DockPanel>
      </TabItem>
      <TabItem Header="Proposed updates">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="150" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ListBox x:Name="ProposalsList" DisplayMemberPath="Label" SelectionChanged="ProposalSelection_Changed" />
          <TextBlock Grid.Row="1" Text="Selected proposal, editable before approval" Margin="0,12,0,7" />
          <TextBox x:Name="ProposalContent" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Reject" Click="RejectProposal_Click" /><Button Content="Approve" Click="ApproveProposal_Click" Style="{StaticResource PrimaryButton}" /></WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Warnings">
        <DockPanel Margin="16"><WrapPanel DockPanel.Dock="Top"><Button Content="Resolve / reopen" Click="ToggleWarning_Click" /><Button Content="Delete selected" Click="DeleteWarning_Click" /></WrapPanel><ListBox x:Name="WarningsList" DisplayMemberPath="Label" Margin="0,12,0,0" /></DockPanel>
      </TabItem>
      <TabItem Header="Settings">
        <StackPanel Margin="20" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="Memory mode" Margin="0,0,0,6" /><ComboBox x:Name="ModeSelector" Width="250" HorizontalAlignment="Left" />
          <CheckBox x:Name="AutomaticProposals" Content="Automatically propose memory updates after AI text is appended" ToolTip="This makes a second model request and may use API credits." />
          <CheckBox x:Name="RequireApproval" Content="Require approval before proposed memory becomes canonical" IsEnabled="False" IsChecked="True" />
          <CheckBox x:Name="IncludeThreads" Content="Include open plot threads in writing requests" />
          <CheckBox x:Name="ContinuityWarnings" Content="Create continuity warnings for possible conflicts" />
          <TextBlock Text="Memory character budget" Margin="0,14,0,6" /><TextBox x:Name="BudgetBox" Width="180" HorizontalAlignment="Left" />
          <TextBlock Text="Maximum retrieved manuscript passages" Margin="0,14,0,6" /><TextBox x:Name="PassagesBox" Width="180" HorizontalAlignment="Left" />
          <TextBlock Margin="0,18,0,8" Text="Turning memory off stops retrieval and updates but keeps saved memory. Deletion is separate and recoverable." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <Button Content="Delete saved memory and move it to recovery" HorizontalAlignment="Left" Click="DeleteMemory_Click" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
