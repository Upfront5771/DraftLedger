<Window x:Class="DraftLedger.App.AiWritingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI writing | DraftLedger" Icon="Assets/DraftLedger.ico" Width="920" Height="930" MinWidth="740" MinHeight="650" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Write the next part" FontFamily="Georgia" FontSize="28" />
      <TextBlock x:Name="TargetLabel" TextWrapping="Wrap" Margin="0,7,0,12" Foreground="{DynamicResource MutedBrush}" />
      <DockPanel x:Name="ConnectionPanel" Margin="0,2"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add" Click="AddConnection_Click" /><Button Content="Edit" Click="EditConnection_Click" /><Button Content="Delete" Click="DeleteConnection_Click" /></StackPanel><TextBlock Text="Connection" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="ConnectionSelector" DisplayMemberPath="Name" SelectionChanged="Connection_Changed" Margin="3" Padding="6" AutomationProperties.Name="API connection" /></DockPanel>
      <DockPanel x:Name="ModelPanel" Margin="0,2"><Button Content="Refresh models" DockPanel.Dock="Right" Click="RefreshModels_Click" /><TextBlock Text="Model" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="ModelSelector" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="Id" SelectionChanged="Model_Changed" KeyUp="ModelFilter_KeyUp" Margin="3" Padding="6" AutomationProperties.Name="Searchable API model" /></DockPanel>
      <TextBlock x:Name="ModelInfo" FontSize="11" Margin="94,3,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
      <DockPanel x:Name="PresetPanel"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="New" Click="NewPreset_Click" /><Button Content="Edit" Click="EditPreset_Click" /><Button Content="Save" Click="SavePreset_Click" /><Button Content="Delete" Click="DeletePreset_Click" /><Button Content="Import ST preset" Click="ImportPreset_Click" /></StackPanel><TextBlock Text="Preset" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="PresetSelector" DisplayMemberPath="Name" SelectionChanged="Preset_Changed" Margin="3" Padding="6" AutomationProperties.Name="Model preset" /></DockPanel>
      <TextBlock x:Name="DestinationInfo" TextWrapping="Wrap" Margin="0,10,0,12" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0"><ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AiStatus" Text="Choose a connection, refresh its model list, and enter your prompt." TextWrapping="Wrap" /></ScrollViewer></Border>
    <TabControl Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}">
      <TabItem Header="Write" Padding="18,8">
        <Grid Margin="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="140" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel x:Name="RequestOptionsPanel"><CheckBox x:Name="StreamToggle" Content="Stream response" VerticalAlignment="Center" Margin="0,4,18,4" /><TextBlock Text="Thinking" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox x:Name="ThinkingSelector" Width="110" Margin="0,4,18,4" Padding="5" AutomationProperties.Name="Thinking setting" /><TextBlock Text="Context" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox x:Name="ContextSelector" Width="175" Margin="0,4" Padding="5" AutomationProperties.Name="Manuscript context" /></WrapPanel>
          <TextBlock Grid.Row="1" Text="Your prompt" Margin="0,12,0,7" FontWeight="SemiBold" />
          <TextBox x:Name="PromptBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt to send to model" />
          <DockPanel Grid.Row="3" Margin="0,10"><TextBlock x:Name="OutputInfo" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="GenerateButton" Content="Generate" Click="Generate_Click" Style="{StaticResource PrimaryButton}" /><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" /></StackPanel></DockPanel>
          <TextBox x:Name="ResponseBox" Grid.Row="4" IsReadOnly="False" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Georgia" FontSize="16" FontWeight="Normal" TextBlock.LineHeight="25" TextOptions.TextFormattingMode="Ideal" Padding="16" MinHeight="120" TextChanged="ResponseBox_TextChanged" AutomationProperties.Name="Editable generated manuscript preview" />
          <DockPanel Grid.Row="5" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ClearButton" Content="Clear output" Click="Clear_Click" IsEnabled="False" /><Button x:Name="AppendButton" Content="Append to section" Click="Append_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" /></StackPanel><TextBlock Text="Review the response, then append it or clear it. Generation never changes the manuscript automatically." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></DockPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="LoreTab" Header="Lorebooks" Padding="18,8">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="Choose reference books for this story" FontSize="19" FontFamily="Georgia" /><TextBlock Text="Enabled books match against the selected manuscript context and your prompt. Only matched entries within the preset's lore budget are sent." TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{DynamicResource MutedBrush}" /><WrapPanel><Button Content="Import lorebook JSON" Click="ImportLore_Click" /><Button Content="Inspect entries" Click="InspectLore_Click" /><Button Content="Delete book" Click="DeleteLore_Click" /></WrapPanel></StackPanel>
          <ListBox x:Name="LoreList" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="LoreEnabled_Click" /></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Context and request" Padding="18,8">
        <DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Review what will be sent" FontSize="19" FontFamily="Georgia" /><TextBlock Text="Preview includes the destination, model, messages, matched lore, and settings. API keys are excluded." TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{DynamicResource MutedBrush}" /><Button x:Name="PreviewButton" Content="Build request preview" Click="Preview_Click" HorizontalAlignment="Left" /></StackPanel><TextBox x:Name="RequestPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" AutomationProperties.Name="Request preview without credentials" /></DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
