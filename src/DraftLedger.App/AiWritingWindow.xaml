<Window x:Class="DraftLedger.App.AiWritingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="API connections | DraftLedger" Icon="Assets/DraftLedger.ico" Width="1180" Height="860" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <DockPanel x:Name="RootPanel" Margin="24">
    <StackPanel x:Name="ConfigurationPanel" DockPanel.Dock="Top">
      <TextBlock Text="API connections and model presets" FontFamily="Georgia" FontSize="28" />
      <TextBlock x:Name="TargetLabel" TextWrapping="Wrap" Margin="0,7,0,12" Foreground="{DynamicResource MutedBrush}" />
      <DockPanel x:Name="ConnectionPanel" Margin="0,2"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add" Click="AddConnection_Click" /><Button Content="Edit" Click="EditConnection_Click" /><Button Content="Delete" Click="DeleteConnection_Click" /></StackPanel><TextBlock Text="Connection" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="ConnectionSelector" DisplayMemberPath="Name" SelectionChanged="Connection_Changed" Margin="3" Padding="6" /></DockPanel>
      <DockPanel x:Name="ModelPanel" Margin="0,2"><Button Content="Refresh models" DockPanel.Dock="Right" Click="RefreshModels_Click" /><TextBlock Text="Model" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="ModelSelector" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="Id" SelectionChanged="Model_Changed" KeyUp="ModelFilter_KeyUp" Margin="3" Padding="6" /></DockPanel>
      <TextBlock x:Name="ModelInfo" FontSize="11" Margin="94,3,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
      <DockPanel x:Name="PresetPanel"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="New" Click="NewPreset_Click" /><Button Content="Save preset" Click="SavePreset_Click" Style="{StaticResource PrimaryButton}" /><Button Content="Delete" Click="DeletePreset_Click" /><Button Content="Import ST preset" Click="ImportPreset_Click" /></StackPanel><TextBlock Text="Preset" Width="90" VerticalAlignment="Center" /><ComboBox x:Name="PresetSelector" DisplayMemberPath="Name" SelectionChanged="Preset_Changed" Margin="3" Padding="6" /></DockPanel>
      <TextBlock x:Name="DestinationInfo" TextWrapping="Wrap" Margin="0,10,0,12" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>
    <StackPanel x:Name="WritingHeader" DockPanel.Dock="Top" Visibility="Collapsed" Margin="20,15,20,8"><TextBlock Text="AI writing" FontFamily="Georgia" FontSize="24" /><TextBlock x:Name="WritingConfigurationSummary" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0"><ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AiStatus" Text="Choose a connection and preset. Edit preset settings below, then choose Save preset." TextWrapping="Wrap" /></ScrollViewer></Border>
    <Grid>
      <ScrollViewer x:Name="PresetSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="4,4,4,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="CORE PRESET" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" /><TextBlock Text="Preset name" /><TextBox x:Name="PresetNameBox" Margin="0,5,0,10" /><TextBlock Text="System instruction" /><TextBox x:Name="SystemPromptBox" MinHeight="130" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Margin="0,5,0,10" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Max output tokens" /><TextBox x:Name="MaxTokensBox" Margin="0,5,0,10" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Thinking protocol" /><ComboBox x:Name="ThinkingProtocolSelector" Margin="0,5,0,10" /></StackPanel></Grid>
            <CheckBox x:Name="CompletionTokenLimitToggle" Content="Use max_completion_tokens" Margin="0,0,0,12" /><TextBlock Text="REQUEST DEFAULTS" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,8" /><CheckBox x:Name="PresetStreamToggle" Content="Stream response" Margin="0,0,0,8" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thinking" /><ComboBox x:Name="PresetThinkingSelector" Margin="0,5,0,10" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Manuscript context" /><ComboBox x:Name="PresetContextSelector" Margin="0,5,0,10" /></StackPanel></Grid>
            <TextBlock Text="SAMPLING" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,8" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Temperature" /><TextBox x:Name="TemperatureBox" Margin="0,5,0,10" /><TextBlock Text="Frequency penalty" /><TextBox x:Name="FrequencyPenaltyBox" Margin="0,5,0,10" /><TextBlock Text="Context character limit" /><TextBox x:Name="ContextCharactersBox" Margin="0,5,0,10" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Top P" /><TextBox x:Name="TopPBox" Margin="0,5,0,10" /><TextBlock Text="Presence penalty" /><TextBox x:Name="PresencePenaltyBox" Margin="0,5,0,10" /><TextBlock Text="Lore character budget" /><TextBox x:Name="LoreCharactersBox" Margin="0,5,0,10" /></StackPanel></Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ADVANCED AND CHARACTER CONTEXT" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" /><TextBlock Text="Stop sequences (JSON array)" /><TextBox x:Name="StopSequencesBox" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,5,0,10" /><TextBlock Text="Extra sampling (JSON object)" /><TextBox x:Name="ExtraSamplingBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,5,0,10" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Character name" /><TextBox x:Name="CharacterNameBox" Margin="0,5,0,10" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="User name" /><TextBox x:Name="UserNameBox" Margin="0,5,0,10" /></StackPanel></Grid>
            <TextBlock Text="Character description" /><TextBox x:Name="CharacterDescriptionBox" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Margin="0,5,0,10" /><TextBlock Text="Character personality" /><TextBox x:Name="CharacterPersonalityBox" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Margin="0,5,0,10" /><TextBlock Text="User persona" /><TextBox x:Name="PersonaBox" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Margin="0,5,0,10" /><TextBlock Text="Imported prompt blocks (JSON array)" /><TextBox x:Name="ImportedPromptsBox" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,5,0,10" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <TabControl x:Name="AiTabs" Visibility="Collapsed" Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}">
        <TabItem x:Name="InputTab" Header="Input" Padding="18,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><WrapPanel x:Name="RequestOptionsPanel" Margin="20,14,20,8"><CheckBox x:Name="StreamToggle" Content="Stream response" Margin="0,4,18,4" /><TextBlock Text="Thinking" VerticalAlignment="Center" /><ComboBox x:Name="ThinkingSelector" Width="110" Margin="6,4,18,4" /><TextBlock Text="Context" VerticalAlignment="Center" /><ComboBox x:Name="ContextSelector" Width="175" Margin="6,4" /></WrapPanel><TextBox x:Name="PromptBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="44,28,44,50" FontFamily="Georgia" FontSize="19" FontWeight="Normal" TextBlock.LineHeight="29" UndoLimit="200" IsUndoEnabled="True" SpellCheck.IsEnabled="True" /><DockPanel Grid.Row="2" Margin="20,8,20,14"><TextBlock Text="Write or paste a complete instruction." FontSize="11" Foreground="{DynamicResource MutedBrush}" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="GenerateButton" Content="Generate" Click="Generate_Click" Style="{StaticResource PrimaryButton}" /><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" /></StackPanel></DockPanel></Grid></TabItem>
        <TabItem x:Name="OutputTab" Header="Output" Padding="18,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock x:Name="OutputInfo" Margin="20,13,20,6" Foreground="{DynamicResource MutedBrush}" /><TextBox x:Name="ResponseBox" Grid.Row="1" IsReadOnly="False" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontFamily="Georgia" FontSize="19" FontWeight="Normal" TextBlock.LineHeight="29" Padding="44,28,44,50" UndoLimit="200" IsUndoEnabled="True" SpellCheck.IsEnabled="True" TextChanged="ResponseBox_TextChanged" /><DockPanel Grid.Row="2" Margin="20,8,20,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ClearButton" Content="Clear output" Click="Clear_Click" IsEnabled="False" /><Button x:Name="AppendButton" Content="Append to section" Click="Append_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" /></StackPanel><TextBlock Text="Edit freely, then append when ready." FontSize="11" Foreground="{DynamicResource MutedBrush}" /></DockPanel></Grid></TabItem>
        <TabItem x:Name="LoreTab" Header="Lorebooks" Padding="18,8"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Choose reference books for this story" FontSize="19" FontFamily="Georgia" /><TextBlock Text="Only matched entries within the preset's lore budget are sent." TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{DynamicResource MutedBrush}" /><WrapPanel><Button Content="Import lorebook JSON" Click="ImportLore_Click" /><Button Content="Inspect entries" Click="InspectLore_Click" /><Button Content="Delete book" Click="DeleteLore_Click" /></WrapPanel></StackPanel><ListBox x:Name="LoreList" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="LoreEnabled_Click" /></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
        <TabItem Header="Context / Request" Padding="18,8"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Review what will be sent" FontSize="19" FontFamily="Georgia" /><Button x:Name="PreviewButton" Content="Build request preview" Click="Preview_Click" HorizontalAlignment="Left" Margin="0,10" /></StackPanel><TextBox x:Name="RequestPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" /></DockPanel></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
