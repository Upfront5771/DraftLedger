<Window x:Class="DraftLedger.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:DraftLedger.Core;assembly=DraftLedger.Core" Title="DraftLedger" Icon="Assets/DraftLedger.ico" Width="1440" Height="940" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type core:Chapter}" ItemsSource="{Binding Sections}"><TextBlock Text="{Binding TreeLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /></HierarchicalDataTemplate>
    <DataTemplate DataType="{x:Type core:Section}"><TextBlock Text="{Binding TreeLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /></DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="23,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/DraftLedger.ico" Width="34" Height="34" Margin="0,0,12,0" SnapsToDevicePixels="True" /><TextBlock Text="DraftLedger" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="  /  A little progress, every day." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Writing library" Click="Library_Click" /><Button Content="Focus  F11" Click="Focus_Click" /></StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9"><DockPanel><TextBlock x:Name="SaveStatus" Text="All writing stays on this computer" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="StatusCounts" Text="Your next story starts here." FontSize="12" /></DockPanel></Border>
    <Grid>
      <Grid x:Name="LibraryPanel" Margin="38,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel><StackPanel><TextBlock Text="Your writing library" FontSize="32" FontFamily="Georgia" /><TextBlock x:Name="LibrarySummary" Margin="0,10,0,22" Foreground="{DynamicResource MutedBrush}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Import text" Click="Import_Click" /><Button Content="Open project folder" Click="OpenFolder_Click" /><Button Content="+ New story" Style="{StaticResource PrimaryButton}" Click="NewStory_Click" /></StackPanel></DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,20"><CheckBox x:Name="ShowArchived" DockPanel.Dock="Right" Content="Show archived" Checked="LibraryFilter_Changed" Unchecked="LibraryFilter_Changed" /><TextBox x:Name="LibrarySearch" Width="340" HorizontalAlignment="Left" TextChanged="LibraryFilter_Changed" ToolTip="Search story titles and synopses" AutomationProperties.Name="Search library" /></DockPanel>
        <Grid Grid.Row="2"><TextBlock x:Name="EmptyLibrary" Text="Make room for a new idea.&#10;&#10;Create a story, or import a .txt or .md file." FontFamily="Georgia" FontSize="22" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
          <ListBox x:Name="StoryCards" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="StoryCards_DoubleClick">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><Border Width="295" MinHeight="220" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,16,16"><StackPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="23" Margin="0,12,0,12" TextWrapping="Wrap" /><TextBlock Text="{Binding CardDetail}" /><ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,20,0,8" /><TextBlock Text="{Binding GoalLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding EditedLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,10" /><StackPanel Orientation="Horizontal"><Button Content="Open story" Click="OpenCard_Click" Tag="{Binding}" /><Button Content="Archive / restore" Click="ArchiveCard_Click" Tag="{Binding}" Padding="8,7" /></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <TextBlock Grid.Row="3" Text="OFFLINE BY DESIGN  ·  Your words, in ordinary Markdown files." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,0" />
      </Grid>
      <Grid x:Name="WorkspacePanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="OutlineColumn" Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition x:Name="DetailsColumn" Width="360" MinWidth="280" MaxWidth="620" /></Grid.ColumnDefinitions>
        <Border x:Name="OutlinePanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="14,22,12,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock Text="MANUSCRIPT" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="StoryTitle" FontSize="22" FontFamily="Georgia" TextWrapping="Wrap" Margin="4,10,0,14" /><WrapPanel><Button Content="+ Chapter" Click="AddChapter_Click" /><Button Content="+ Section" Click="AddSection_Click" /></WrapPanel></StackPanel>
            <StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="Rename" Click="Rename_Click" /><Button Content="Details" Click="NodeDetails_Click" /><Button Content="Copy" Click="Duplicate_Click" /></WrapPanel><WrapPanel><Button Content="↑" ToolTip="Move up" Click="MoveUp_Click" /><Button Content="↓" ToolTip="Move down" Click="MoveDown_Click" /><Button Content="Delete" Click="Delete_Click" /></WrapPanel><Button Content="Story details and goal" Click="StoryDetails_Click" /><Button Content="Show project files" Click="ShowFiles_Click" /></StackPanel>
            <TreeView x:Name="Outline" Margin="0,12,0,10" SelectedItemChanged="Outline_SelectedItemChanged" AllowDrop="True" PreviewMouseLeftButtonDown="Outline_MouseDown" PreviewMouseMove="Outline_MouseMove" Drop="Outline_Drop" />
          </DockPanel>
        </Border>
        <Grid Grid.Column="1" Background="{DynamicResource PaperBrush}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Padding="24,16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><DockPanel><StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock x:Name="Breadcrumb" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="SectionTitle" Text="Choose a section" FontSize="20" FontFamily="Georgia" Margin="0,5,0,0" /></StackPanel><WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Import" Click="Import_Click" /><Button Content="Export" Click="Export_Click" /><Button Content="Find" Click="Find_Click" /></WrapPanel></DockPanel></Border>
          <Border x:Name="FindPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Padding="12"><StackPanel><WrapPanel><TextBox x:Name="FindText" Width="180" Margin="3" ToolTip="Find text" AutomationProperties.Name="Find text" /><Button Content="Next" Click="FindNext_Click" /><Button Content="Search story" Click="SearchStory_Click" /><Button Content="×" Click="CloseFind_Click" /></WrapPanel><WrapPanel><TextBox x:Name="ReplaceText" Width="180" Margin="3" ToolTip="Replace with" AutomationProperties.Name="Replace with" /><Button Content="Replace" Click="Replace_Click" /><Button Content="Replace all" Click="ReplaceAll_Click" /></WrapPanel><TextBlock x:Name="FindMessage" FontSize="12" Margin="4" Foreground="{DynamicResource MutedBrush}" /></StackPanel></Border>
          <TabControl x:Name="WritingTabs" Grid.Row="2" Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="0" SelectionChanged="WritingTabs_SelectionChanged" AutomationProperties.Name="Writing mode">
            <TabItem x:Name="EditorTab" Header="Editor" IsSelected="True">
              <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="44,30,44,54" FontFamily="Georgia" FontSize="19" FontWeight="Normal" FontStyle="Normal" TextBlock.LineHeight="29" TextOptions.TextFormattingMode="Ideal" UndoLimit="200" IsUndoEnabled="True" IsEnabled="False" SpellCheck.IsEnabled="True" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" AutomationProperties.Name="Section manuscript" />
            </TabItem>
            <TabItem x:Name="ReadTab" Header="Read">
              <RichTextBox x:Name="Reader" IsReadOnly="True" IsUndoEnabled="False" IsEnabled="False" BorderThickness="0" Padding="0" Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}" SelectionBrush="{DynamicResource SelectionBrush}" SelectionTextBrush="{DynamicResource SelectionTextBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SelectionChanged="Reader_SelectionChanged" AutomationProperties.Name="Formatted section reading view" />
            </TabItem>
          </TabControl>
          <TextBlock x:Name="EditorHint" Grid.Row="3" Text="Use *italics* or **bold**. Your draft saves automatically." FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="8" />
        </Grid>
        <GridSplitter x:Name="DetailsSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
        <Border x:Name="DetailsPanel" Grid.Column="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Expander Header="AT A GLANCE" IsExpanded="True"><StackPanel Margin="4,8,4,14"><TextBlock x:Name="BigWords" Text="0" FontFamily="Georgia" FontSize="42" /><TextBlock Text="words in this section" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18" /><TextBlock x:Name="SelectionStats" Text="Selection: 0 words" Margin="0,0,0,12" /><TextBlock x:Name="DetailStats" TextWrapping="Wrap" LineHeight="27" /><Separator Margin="0,16" /><TextBlock Text="STORY GOAL" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="GoalText" Margin="0,12,0,10" TextWrapping="Wrap" /><ProgressBar x:Name="GoalProgress" /><TextBlock x:Name="SessionText" Margin="0,16,0,0" TextWrapping="Wrap" /></StackPanel></Expander>
            <Expander Header="SCENE PURPOSE / NOTES" IsExpanded="True"><StackPanel Margin="4,8,4,14"><TextBox x:Name="SceneNotes" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="SceneNotes_TextChanged" IsEnabled="False" AutomationProperties.Name="Scene notes" /></StackPanel></Expander>
            <Expander Header="MEMORY &amp; CONTINUITY" IsExpanded="True"><StackPanel Margin="4,8,4,14"><CheckBox x:Name="MemoryEnabled" Content="Enable long-story memory" Checked="MemoryEnabled_Changed" Unchecked="MemoryEnabled_Changed" /><TextBlock x:Name="MemorySummary" Text="Off for this story" TextWrapping="Wrap" Margin="4,2,4,8" Foreground="{DynamicResource MutedBrush}" /><Button Content="Manage memory and continuity" Click="Memory_Click" /><Button Content="Preview memory context" Click="MemoryPreview_Click" /></StackPanel></Expander>
            <Expander Header="AI WRITING"><StackPanel Margin="4,8,4,14"><TextBlock Text="Generate and review prose before adding it to the open section." TextWrapping="Wrap" Margin="4,0,4,8" Foreground="{DynamicResource MutedBrush}" /><Button Content="Open AI writing" Click="AiWriting_Click" Style="{StaticResource PrimaryButton}" /></StackPanel></Expander>
            <Expander Header="SETTINGS"><StackPanel Margin="4,8,4,14"><Button Content="Appearance and application settings" Click="Settings_Click" /></StackPanel></Expander>
            <Expander Header="FILES &amp; RECOVERY"><StackPanel Margin="4,8,4,14"><Button Content="Snapshot now" Click="Snapshot_Click" /><Button Content="Version history" Click="History_Click" /><Button Content="Back up project as ZIP" Click="Backup_Click" /><Button Content="Reload from disk" Click="Reload_Click" /></StackPanel></Expander>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
